{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "plugins": ["format-guard"],
  "rules": {
    "format-guard/require-format": [
      "warn",
      {
        "rules": [
          {
            "pattern": "Count$",
            "functions": ["formatCount", "formatNumber"],
            "methods": ["toLocaleString"]
          },
          {
            "pattern": "Date$",
            "functions": ["formatDate", "formatTimezone"],
            "methods": []
          }
        ]
      }
    ]
  }
}
