{
  "name": "eslint-plugin-format-guard",
  "version": "0.1.0",
  "description": "ESLint plugin that requires name-pattern matched values (e.g. *Count, *Date) to be formatted before rendering in JSX",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "rules",
    "utils"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "jsx",
    "tsx",
    "format"
  ],
  "scripts": {
    "test": "mocha \"tests/**/*.test.js\"",
    "lint": "eslint index.js rules utils tests",
    "example": "eslint --no-eslintrc -c examples/.eslintrc.json --resolve-plugins-relative-to . --ext .js,.jsx,.ts,.tsx examples"
  },
  "peerDependencies": {
    "eslint": ">=7.0.0"
  },
  "engines": {
    "node": ">=12.22.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/parser": "5.62.0",
    "babel-eslint": "10.1.0",
    "eslint": "7.29.0",
    "eslint-visitor-keys": "1.3.0",
    "espree": "7.3.1",
    "mocha": "9.2.2",
    "typescript": "4.9.5"
  }
}
