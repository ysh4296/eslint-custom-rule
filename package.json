{
  "name": "eslint-plugin-custom-rule",
  "version": "0.1.0",
  "description": "Custom ESLint rules (ESLint 7.x)",
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "scripts": {
    "test": "yarn typecheck && mocha",
    "test:watch": "mocha --watch --watch-files lib,tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .js,.ts lib tests",
    "playground": "eslint --no-eslintrc -c playground/.eslintrc.js --rulesdir lib/rules --no-ignore --ext .js,.jsx,.ts,.tsx playground"
  },
  "peerDependencies": {
    "eslint": ">=7.0.0"
  },
  "devDependencies": {
    "@types/eslint": "7.29.0",
    "@types/mocha": "9.1.1",
    "@types/node": "16.18.126",
    "@typescript-eslint/parser": "5.62.0",
    "babel-eslint": "10.1.0",
    "eslint": "7.29.0",
    "eslint-plugin-eslint-plugin": "^3.6.1",
    "eslint-visitor-keys": "1.3.0",
    "espree": "7.3.1",
    "mocha": "^9.2.2",
    "ts-node": "10.9.2",
    "typescript": "4.9.5"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "license": "MIT"
}
